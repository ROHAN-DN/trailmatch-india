# next-auth@4.24.15 declares a peerOptional range of nodemailer@^7.0.7.
# This project intentionally uses nodemailer@^9.0.4 (nodemailer <7.0.14 has
# a known ReDoS advisory — see FIXES_2026-08-05.md's dependency-vulnerability
# triage). next-auth's EmailProvider only calls nodemailer's core
# createTransport/sendMail API, which has been stable across these major
# versions; the peer range itself is just conservative, not a real
# incompatibility. Without this, a plain `npm install` fails with ERESOLVE.
legacy-peer-deps=true
