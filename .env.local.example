# ═══════════════════════════════════════════════════════════════════
# TrialMatch India — Environment Variables
# Phase 1 + Phase 2
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in all values before deploying.
# Never commit .env.local to version control.
# On Vercel: add all variables under Project → Settings → Environment Variables

# ── Supabase ───────────────────────────────────────────────────────
# https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── NextAuth ───────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-chars

# MFA — used to encrypt TOTP secrets at rest (AES-256-GCM). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Losing/rotating this key
# invalidates every enrolled user's stored secret — they'd need to
# re-enroll. Treat it with the same care as NEXTAUTH_SECRET.
MFA_ENCRYPTION_KEY=generate-a-real-64-char-hex-key-see-comment-above

# ── Google OAuth (Sign-In with Google) ────────────────────────────
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ── Anthropic Claude API ───────────────────────────────────────────
# https://console.anthropic.com → API Keys
# Used for: AI matching, pre-screening checklists, protocol parsing, enrollment monitor
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Resend (email delivery) ────────────────────────────────────────
# https://resend.com → API Keys
# Used for: match PDF reports, sponsor engagement notifications, team invites
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=reports@yourdomain.com
RESEND_FROM_NAME=TrialMatch India

# ── Gupshup (WhatsApp Business API) ───────────────────────────────
# https://www.gupshup.io → Create WhatsApp Business App
# Used for: match result notifications, pre-screening checklists,
#           enrollment alerts, engagement requests, weekly pace reports
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_SOURCE_NUMBER=919XXXXXXXXX
# Your registered WhatsApp Business number in E.164 format (with 91 prefix, no +)
GUPSHUP_APP_NAME=TrialMatchIndia

# ── WhatsApp message templates (submit to Gupshup before going live) ──
#
# CRITICAL: Without approved templates, ALL system-initiated WhatsApp
# messages (alerts, engagement requests, weekly reports) fall back to
# email only. Free-form messages only work within a 24h window where
# the recipient messaged YOUR number first — which never applies to
# cold coordinator/sponsor notifications.
#
# Submit these 4 templates in Gupshup Dashboard → Templates → New Template.
# Set each env var to the approved template ID/name once approved.
# Leave blank while pending — the system falls back to email automatically.
#
# Template 1 — ENROLLMENT_ALERT
#   Category: UTILITY
#   Body: "{{1}} patient(s) at {{2}} need attention in TrialMatch India. Log in: {{3}}"
GUPSHUP_TEMPLATE_ENROLLMENT_ALERT=

# Template 2 — WEEKLY_REPORT
#   Category: UTILITY
#   Body: "Weekly report for {{1}}: {{2}} enrolled, {{3}} pending. View: {{4}}"
GUPSHUP_TEMPLATE_WEEKLY_REPORT=

# Template 3 — ENGAGEMENT_COORDINATOR (sponsor → site)
#   Category: UTILITY
#   Body: "A sponsor is interested in your site for a {{1}} trial. Respond in TrialMatch: {{2}}"
GUPSHUP_TEMPLATE_ENGAGEMENT_COORDINATOR=

# Template 4 — ENGAGEMENT_SPONSOR (site → sponsor, after coordinator responds)
#   Category: UTILITY
#   Body: "A site has {{1}} your engagement request in TrialMatch India. View: {{2}}"
GUPSHUP_TEMPLATE_ENGAGEMENT_SPONSOR=

# ── Stripe (Billing) ──────────────────────────────────────────────
# https://stripe.com → Developers → API Keys
# Use test keys (sk_test_...) for development, live keys for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create in Stripe Dashboard → Products
# All prices should be recurring, monthly, INR currency
STRIPE_PRICE_STARTER=price_...     # ₹7,999/month
STRIPE_PRICE_PRO=price_...         # ₹19,999/month
# Enterprise is custom pricing — no Stripe price ID needed

# ── CRON jobs (Vercel Cron) ────────────────────────────────────────
# Generate: openssl rand -base64 32
# Used by all cron endpoints to verify the caller is Vercel
CRON_SECRET=your-cron-secret-minimum-32-chars

# ── ABDM (Ayushman Bharat Digital Mission) ────────────────────────
# Register at: https://sandbox.abdm.gov.in/
# Production:  https://dev.abdm.gov.in/
# Documentation: https://sandbox.abdm.gov.in/docs/

# Your ABDM application credentials (from NHA developer portal)
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret

# Gateway base URL (use sandbox for dev, production URL for live)
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_HEALTH_INFO_URL=https://dev.abdm.gov.in/hiu

# Your HIU (Health Information User) entity ID — assigned by NHA after registration
ABDM_HIU_ID=your-hiu-entity-id

# No static encryption key needed — lib/fidelius.ts generates a fresh
# ephemeral Curve25519 keypair + nonce per ABDM session (perfect forward
# secrecy, matching ABDM's actual Fidelius protocol). Nothing to configure
# here. See lib/fidelius.ts for how this was implemented and verified.

# Public URL for ABDM to deliver health records to (must be reachable by ABDM servers)
# For local dev: use ngrok tunnel — ngrok http 3000 → use the https URL
ABDM_CALLBACK_URL=https://YOUR_VERCEL_URL/api/abdm/callback

# ── App config ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=TrialMatch India
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ── Phase 2: Sponsor portal ────────────────────────────────────────
# No additional env vars required for sponsor portal.
# Sponsor org type is set directly in Supabase:
#   UPDATE organizations SET org_type = 'pharma' WHERE id = 'org-uuid';
# Valid org_type values: hospital, academic, cro, pharma, biotech, research_center
# Sponsor types (pharma, biotech) get the Sponsor Portal tab.
# Coordinator types (hospital, academic, cro, research_center) get patient-facing tabs.

# ── Phase 2: Enrollment monitor ───────────────────────────────────
# No additional env vars — uses CRON_SECRET (above) and existing Gupshup + Resend.
# The enrollment monitor cron runs every 6 hours via vercel.json.
# Weekly pace reports run on Sundays.

# ── Phase 2: Insta HMS export ─────────────────────────────────────
# No additional env vars — HMS export is a CSV download, no external API required.
# Coordinator clicks "Export to Insta HMS" on any completed job.

# ══════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST
# ══════════════════════════════════════════════════════════════════
# Before going live, verify all of the following:
#
# Supabase:
#   [ ] Run schema.sql in SQL Editor
#   [ ] Run migrations 001 through 017 in order (17 files in supabase/migrations/ —
#       verify with `ls supabase/migrations/ | wc -l` before assuming you're done.
#       013_fixes.sql and 014_security_fixes.sql are NOT optional: 013 fixes a real
#       site-twin seed upsert conflict + adds the enrollment monitor trigger backfill,
#       014 adds RLS to rematch_runs and the source_status column the matcher needs.
#       016_audit_log_columns_fix.sql is NOT optional either: without it, every
#       audit_log write from lib/audit.ts fails silently (see that migration's
#       header comment) — the audit trail this platform's compliance posture
#       depends on is empty without it. 017_structured_clinical_data.sql adds
#       structured lab/medication/biomarker/comorbidity/allergy tables alongside
#       the existing free-text patient fields — additive, nothing else depends
#       on it being run yet, but it's the prerequisite for a future deterministic
#       eligibility layer.)
#   [ ] Enable Row Level Security on all tables — verify with:
#       select table_name from information_schema.tables t
#       where table_schema='public' and not exists (
#         select 1 from pg_tables pt where pt.tablename = t.table_name and pt.rowsecurity
#       );
#       (should return zero rows once 014 has run)
#   [ ] Enable pg_cron extension (for weekly site twin refresh)
#   [ ] Set Supabase project to India region (ap-south-1)
#
# Seed scripts (run once after migrations):
#   [ ] npx ts-node --project tsconfig.scripts.json scripts/seed-pi-contacts.ts
#   [ ] npx ts-node --project tsconfig.scripts.json scripts/seed-site-twins.ts
#
# Dependencies:
#   [ ] Confirm `next` is >=14.2.35 in package.json / package-lock.json — 14.2.3
#       through 14.2.33 carry a disclosed DoS vulnerability chain (CVE-2025-55183/
#       55184/67779). This app is Pages Router only (not App Router), so the more
#       severe RCE CVEs in that chain don't apply here — but there's no reason to
#       ship a version npm itself flags as vulnerable. Run `npm audit` and resolve
#       anything above low severity before going live.
#
# Stripe:
#   [ ] Create Starter and Pro products with INR monthly prices
#   [ ] Add webhook endpoint pointing to /api/billing/webhook
#   [ ] Enable webhook events: checkout.session.completed, customer.subscription.*
#
# ABDM:
#   [ ] Complete HIU registration with NHA
#   [ ] Set ABDM_CALLBACK_URL to your production Vercel URL
#   [ ] Test with sandbox ABHA: 12-3456-7890-1234
#   [ ] lib/fidelius.ts implements ABDM's real Fidelius encryption (Curve25519
#       in BouncyCastle Short Weierstrass form, HKDF-SHA256, AES-256-GCM) — NOT
#       standard X25519. Its curve parameters were verified against the
#       primary BouncyCastle source and its output was checked byte-for-byte
#       against a published test vector, independently reproduced in the same
#       session via dimagi/pyfidelius's real source. See lib/fidelius.ts's
#       top comment and lib/__tests__/fidelius.test.ts for details.
#   [ ] NOT YET DONE: this has not been run against ABDM's actual sandbox
#       gateway (sandbox.abdm.gov.in) — that requires real ABDM sandbox
#       credentials this environment didn't have. Before requesting any real
#       patient's health data: run the full OTP → request → callback flow
#       against the real sandbox with a sandbox ABHA number and confirm a
#       real HIP's encrypted response decrypts correctly. Test vector
#       matching a reference implementation is strong evidence the algorithm
#       is right; it is not the same as confirming interop with ABDM's live
#       systems.
#
# Gupshup:
#   [ ] Verify WhatsApp Business number is active and approved
#   [ ] Submit all 4 message templates (see GUPSHUP_TEMPLATE_* above)
#   [ ] Set GUPSHUP_TEMPLATE_* env vars once each template is approved
#   [ ] Test with a real India mobile number before launch
#   [ ] Note: template approval takes 1–5 business days — submit on day 1
#
# Matching engine (see lib/matcher.ts):
#   [ ] Understand that a match result with zero matches is a legitimate outcome
#       (either a real zero-result search, or a source registry was unreachable —
#       check source_status on the result / the banner in BatchPanel). The matcher
#       no longer fabricates example trials when live data is unavailable.
#   [ ] CTRI has no official API — fetchCTRI() scrapes CTRI's HTML search page
#       through a third-party CORS proxy (api.allorigins.win). This is inherently
#       fragile. Monitor server logs for repeated CTRI fetch errors after launch;
#       if the proxy becomes unreliable, this needs a more durable data source.
#
# Vercel:
#   [ ] Add all env vars in Vercel Project Settings
#   [ ] Verify cron jobs are registered (Vercel Dashboard → Cron Jobs)
#   [ ] Set NEXTAUTH_URL to your production domain (not localhost)
